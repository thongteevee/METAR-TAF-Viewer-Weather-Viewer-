<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather Viewer" Width="1000" MinHeight="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="20" Background="White" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <!-- Single container (StackPanel) for all content -->
            <StackPanel>
                <!-- Data Grid Section -->
                <Grid Width="1000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <!-- Column 1: User Input -->
                        <ColumnDefinition Width="3*" />
                        <!-- Column 2: Decoded Weather -->
                        <ColumnDefinition Width="2*" />
                        <!-- Column 3: Raw METAR -->
                        <ColumnDefinition Width="2*" />
                        <!-- Column 4: Raw TAF -->
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: ICAO Input & Buttons -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border CornerRadius="15" Background="#EEEEEE" Padding="5">
                            <TextBox Name="IcaoInput" Width="250" Height="50"
                                     BorderThickness="0" FontSize="16"
                                     TextAlignment="Center"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"/>
                        </Border>
                        <Button Content="Get Weather" Click="FetchWeather" Width="150" Height="50"
                                Margin="10" BorderThickness="0"
                                Background="#007ACC" Foreground="White" FontSize="16"/>

                        <Button Name="ToggleKnotsButton" Content="Switch to Knots" Click="ToggleKnots"
                                Width="150" Height="40" Margin="10" BorderThickness="0"
                                Background="#444" Foreground="White" FontSize="14"/>

                        <Button Name="ToggleUnits" Content="Switch to Imperial" Click="ToggleUnitFormat"
                                Width="150" Height="40" Margin="10" BorderThickness="0"
                                Background="#444" Foreground="White" FontSize="14"/>
                    </StackPanel>

                    <!-- Column 2: Decoded Weather Data -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10">
                        <TextBlock Name="AirportNameOutput" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Name="ReportTimeOutput" FontSize="16"/>
                        <TextBlock Name="TemperatureOutput" FontSize="18"/>
                        <TextBlock Name="WindOutput" FontSize="18"/>
                        <TextBlock Name="WindGustOutput" FontSize="18"/>
                        <TextBlock Name="VisibilityOutput" FontSize="18"/>
                        <TextBlock Name="CloudCoverOutput" FontSize="14"/>
                    </StackPanel>

                    <!-- Column 3: Raw METAR Data -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="10">
                        <TextBlock Text="METAR Report" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Name="RawMetarOutput" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Column 4: Raw TAF Data -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="10">
                        <TextBlock Text="TAF Report" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Name="RawTafOutput" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Compass with Runway Section -->
                <Canvas Width="300" Height="300" Margin="0,20,0,0">
                    <!-- Compass Circle -->
                    <Ellipse Width="300" Height="300" Stroke="Black" StrokeThickness="3"/>

                    <!-- Cardinal Directions -->
                    <TextBlock Text="N" FontSize="16" FontWeight="Bold" Canvas.Left="140" Canvas.Top="5"/>
                    <TextBlock Text="E" FontSize="16" FontWeight="Bold" Canvas.Left="275" Canvas.Top="140"/>
                    <TextBlock Text="S" FontSize="16" FontWeight="Bold" Canvas.Left="140" Canvas.Top="275"/>
                    <TextBlock Text="W" FontSize="16" FontWeight="Bold" Canvas.Left="5" Canvas.Top="140"/>

                    <!-- Runway (Rotates dynamically in C#) -->
                    <Rectangle Name="RunwayVisual" Width="200" Height="30" Fill="Gray" Stroke="Black" StrokeThickness="2"
                               Canvas.Left="50" Canvas.Top="135" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="310"/>
                            <!-- Default angle; updated in C# -->
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <!-- Runway Numbers -->
                    <TextBlock Name="RunwayStartLabel" Text="31" FontSize="18" FontWeight="Bold" Foreground="White"
                               Canvas.Left="90" Canvas.Top="140"/>
                    <TextBlock Name="RunwayEndLabel" Text="13" FontSize="18" FontWeight="Bold" Foreground="White"
                               Canvas.Left="190" Canvas.Top="140"/>

                    <!-- Wind Direction Arrow (Updated dynamically in C#) -->
                    <Line Name="WindArrow" X1="150" Y1="50" X2="150" Y2="100" Stroke="Red" StrokeThickness="3"/>
                    <Polygon Name="WindArrowHead" Fill="Red"
                             Points="145,100 155,100 150,110"/>
                </Canvas>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>