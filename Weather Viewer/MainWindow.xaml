<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather Viewer" Width="1000" MinHeight="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Border CornerRadius="20" Background="White" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Width="1000">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Border CornerRadius="15" Background="#EEEEEE" Padding="5" Margin="10">
                            <TextBox Name="IcaoInput" Width="187" Height="50" FontSize="16" TextAlignment="Center" KeyDown="IcaoInput_KeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                        <TextBlock Text="Enter ICAO"
                                       Foreground="LightGray"
                                       Margin="5,0,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" 
                                       Visibility="{Binding Text.IsEmpty, 
                                                    RelativeSource={RelativeSource TemplatedParent}, 
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>
                        <ComboBox Name="RunwayComboBox" Width="150" Height="40" Margin="10"
                                  SelectionChanged="RunwayComboBox_SelectionChanged"/>
                        <Button Content="Get Weather" Click="FetchWeather" Width="150" Height="50"
                                Margin="10" Background="#007ACC" Foreground="White"/>
                        <Button Name="WindUnitSwitch" Content="Switch to Knots" Click="ToggleKnots"
                                Width="150" Height="40" Margin="10" Background="#444" Foreground="White"/>
                        <Button Name="UnitSwitch" Content="Switch to Imperial" Click="ToggleUnitFormat"
                                Width="150" Height="40" Background="#444" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Name="AirportNameOutput" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Name="ReportTimeOutput" FontSize="16"/>
                        <TextBlock Name="TemperatureOutput" FontSize="18"/>
                        <TextBlock Name="WindOutput" FontSize="18"/>
                        <TextBlock Name="WindGustOutput" FontSize="18"/>
                        <TextBlock Name="VisibilityOutput" FontSize="18"/>
                        <TextBlock Name="CloudCoverOutput" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="10">
                        <TextBlock Text="METAR Report" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Name="RawMetarOutput" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="10">
                        <TextBlock Text="TAF Report" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Name="RawTafOutput" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Canvas x:Name="CompassCanvas" Width="300" Height="300" Margin="0,20,0,0">
                    <Ellipse Width="300" Height="300" Stroke="Black" StrokeThickness="3"/>
                    <TextBlock Text="N" Canvas.Left="140" Canvas.Top="5" FontWeight="Bold"/>
                    <TextBlock Text="E" Canvas.Left="275" Canvas.Top="140" FontWeight="Bold"/>
                    <TextBlock Text="S" Canvas.Left="140" Canvas.Top="275" FontWeight="Bold"/>
                    <TextBlock Text="W" Canvas.Left="5" Canvas.Top="140" FontWeight="Bold"/>
                    <Line Name="RunwayLine" X1="150" Y1="290" X2="150" Y2="10"
                          Stroke="Gray" StrokeThickness="20" StrokeDashArray="15,5"/>
                    <Line Name="ThresholdStart" Stroke="white" StrokeThickness="5" StrokeDashArray="5,3"/>
                    <Line Name="ThresholdEnd" Stroke="white" StrokeThickness="5" StrokeDashArray="5,3"/>
                    <TextBlock Name="RunwayStartLabel" Text="" FontSize="18" FontWeight="Bold" Foreground="Black"/>
                    <TextBlock Name="RunwayEndLabel" Text="" FontSize="18" FontWeight="Bold" Foreground="Black"/>
                    <Line Name="WindArrow" X1="150" Y1="290" X2="150" Y2="10"
                          Stroke="Red" StrokeThickness="3"/>
                    <Polygon Name="WindArrowHead" Fill="Red" Points="145,10 155,10 150,0"/>
                </Canvas>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>