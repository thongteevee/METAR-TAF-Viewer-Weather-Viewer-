<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather Viewer" Width="1000" MinHeight="450" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="20" Background="White" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Width="1000">
                <!-- Fixed width -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <!-- User Input -->
                    <ColumnDefinition Width="3*" />
                    <!-- Decoded Weather -->
                    <ColumnDefinition Width="2*" />
                    <!-- METAR -->
                    <ColumnDefinition Width="2*" />
                    <!-- TAF -->
                </Grid.ColumnDefinitions>

                <!-- Column 1: ICAO Input & Buttons -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="15" Background="#EEEEEE" Padding="5">
                        <TextBox Name="IcaoInput" Width="250" Height="50"
                                 BorderThickness="0" FontSize="16"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"/>
                    </Border>
                    <Button Content="Get Weather" Click="FetchWeather" Width="150" Height="50"
                            Margin="10" BorderThickness="0"
                            Background="#007ACC" Foreground="White" FontSize="16"/>

                    <Button Name="ToggleKnotsButton" Content="Switch to Knots" Click="ToggleKnots"
                            Width="150" Height="40" Margin="10" BorderThickness="0"
                            Background="#444" Foreground="White" FontSize="14"/>

                    <Button Name="ToggleUnits" Content="Switch to Imperial" Click="ToggleUnitFormat"
                            Width="150" Height="40" Margin="10" BorderThickness="0"
                            Background="#444" Foreground="White" FontSize="14"/>
                </StackPanel>

                <!-- Column 2: Decoded Weather Data -->
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <TextBlock Name="TemperatureOutput" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Name="DewPointOutput" FontSize="18"/>
                    <TextBlock Name="PressureOutput" FontSize="18"/>
                    <TextBlock Name="VisibilityOutput" FontSize="18"/>
                    <!-- Increased font size -->
                    <TextBlock Name="WindOutput" FontSize="18"/>
                    <TextBlock Name="WindDirectionOutput" FontSize="18"/>
                    <TextBlock Name="CloudCoverOutput" FontSize="14"/>
                    <TextBlock Name="TafDecodedOutput" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Column 3: Raw METAR Data -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="METAR Report" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Name="RawMetarOutput" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Column 4: Raw TAF Data -->
                <StackPanel Grid.Column="3" VerticalAlignment="Top">
                    <TextBlock Text="TAF Report" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Name="RawTafOutput" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>